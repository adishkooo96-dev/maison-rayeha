rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if the requesting user is an admin
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true)) ||
        request.auth.token.email == 'adishkooo96@gmail.com'
      );
    }

    // Helper function to verify if the requesting user is an Owner
    function isOwner() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true) ||
        request.auth.token.email == 'adishkooo96@gmail.com'
      );
    }

    // Products collection: public read, admin write, or inventory stock decrement on order
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'inStock']) &&
        request.resource.data.stockQuantity is int &&
        request.resource.data.stockQuantity >= 0 &&
        request.resource.data.stockQuantity <= resource.data.stockQuantity &&
        request.resource.data.inStock == (request.resource.data.stockQuantity > 0)
      );
    }

    // Orders collection:
    // - create: open to guests (userId is null) or authenticated users creating their own order
    // - read: only the order owner or an admin
    // - update/delete: admin only
    match /orders/{orderId} {
      allow create: if request.resource.data.userId == null || 
        (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow read: if isAdmin() || 
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Users collection:
    // - create: authenticated user creating their own document (role default customer, isOwner false)
    // - read: user themselves or admin
    // - update:
    //    1. Self-update: user can update own document, but CANNOT touch 'role' or 'isOwner'
    //    2. Owner update: Owner (isOwner == true) can update any user document, including role and isOwner
    //    3. Regular Admin update: Regular admin (isAdmin() without isOwner) can ONLY update documents
    //       where the target is currently a customer (resource.data.role != 'admin') and CANNOT touch 'isOwner'
    // - delete: Owner only
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if 
        // 1. Self update (cannot touch role or isOwner)
        (request.auth != null && request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isOwner']))
        ||
        // 2. Owner has full permission to manage any user (including other admins)
        isOwner()
        ||
        // 3. Regular admin: can promote a customer to admin, but CANNOT touch existing admins or isOwner field
        (isAdmin() && 
          resource.data.role != 'admin' && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isOwner']));

      allow delete: if isOwner();
    }

    // Coupons collection:
    match /coupons/{code} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Site content collection:
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner();
    }

    // Chats collection & messages subcollection (permissive for live support chat):
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
